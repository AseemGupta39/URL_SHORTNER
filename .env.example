# Database Configuration
DATABASE_PATH=urls.db

# ID Generator Configuration
# For multiple instances, use different DATACENTER_ID (0-15) and WORKER_ID (0-3)
DATACENTER_ID=0
WORKER_ID=0

# Epoch timestamp in seconds (2024-01-01 00:00:00 UTC)
# Change this if you want a different starting point
EPOCH_SEC=1704067200

# Bit Allocation (41 bits total for 7-character codes)
# WARNING: Changing these affects the ID structure and capacity
# Current configuration: 28+4+2+7 = 41 bits

TIMESTAMP_BITS=28   
# 8.51 years time range
DATACENTER_BITS=4   
# 16 datacenters (0-15)
WORKER_BITS=2       
# 4 workers per DC (0-3)
SEQUENCE_BITS=7     
# 128 IDs/second per worker

# Application Configuration
BASE_DOMAIN=localhost:8000
BASE_URL_SCHEME=https  
# http or https

# Server Configuration
HOST=0.0.0.0  
# Use 0.0.0.0 to listen on all interfaces
PORT=8000
RELOAD=True  
# Set to False in production

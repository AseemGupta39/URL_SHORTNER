# Database Configuration
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///urls.db
# Production (PostgreSQL - Neon/Supabase):
# DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

# ID Generator Configuration
# For multiple instances, use different DATACENTER_ID (0-15) and WORKER_ID (0-3)
DATACENTER_ID=0
WORKER_ID=0

# Epoch timestamp in seconds (2024-01-01 00:00:00 UTC)
# Change this if you want a different starting point
EPOCH_SEC=1704067200

# Bit Allocation (47 bits total for 8-character codes)
# WARNING: Changing these affects the ID structure and capacity
# Current configuration: 31+4+2+10 = 47 bits

TIMESTAMP_BITS=31
# ~50 years time range (until ~2092)
DATACENTER_BITS=4
# 16 datacenters (0-15)
WORKER_BITS=2
# 4 workers per DC (0-3)
SEQUENCE_BITS=10
# 1024 IDs/second per worker (65,536 total IDs/sec)

# Application Configuration
BASE_DOMAIN=localhost:8000
BASE_URL_SCHEME=https  
# http or https

# Server Configuration
HOST=0.0.0.0
# Use 0.0.0.0 to listen on all interfaces
PORT=8000
RELOAD=True
# Set to False in production

# CORS Configuration
# Comma-separated list of allowed origins for frontend requests
# Development: Include localhost URLs for local testing
# Production: Replace with your deployed frontend URL (e.g., https://your-app.vercel.app)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# Logging Configuration
# Set log level for application logs
# Options: DEBUG (most verbose), INFO, WARNING, ERROR, CRITICAL (least verbose)
# Development: DEBUG to see all logs including intermediate steps
# Production: INFO or WARNING to reduce log verbosity
LOG_LEVEL=DEBUG

# Cache Configuration
# Enable in-memory caching for faster URL lookups
CACHE_ENABLED=True
# Maximum number of URLs to cache (adjust based on memory)
CACHE_MAX_SIZE=1000
# Time to live in seconds (default: 1 hour = 3600 seconds)
CACHE_TTL_SECONDS=3600

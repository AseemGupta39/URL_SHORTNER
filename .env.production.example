# Production Environment Variables
# Copy this file and set these in your Vercel dashboard: Settings > Environment Variables

# Database Configuration (Neon PostgreSQL)
# Get this from Neon dashboard after creating a database
DATABASE_URL=postgresql+asyncpg://username:password@ep-xxx-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Configuration
# This should be your Vercel deployment URL (without https://)
BASE_DOMAIN=your-app.vercel.app
BASE_URL_SCHEME=https

# CORS Configuration
# Add your frontend URL here (Vercel will provide this after deployment)
CORS_ORIGINS=https://your-app.vercel.app

# Logging Configuration
LOG_LEVEL=INFO

# ID Generator Configuration (same as development)
DATACENTER_ID=0
WORKER_ID=0
EPOCH_SEC=1704067200
TIMESTAMP_BITS=28
DATACENTER_BITS=4
WORKER_BITS=2
SEQUENCE_BITS=7

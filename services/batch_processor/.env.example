# =============================================================================
# Batch Processor Service Environment Variables
# This service processes queued URLs and inserts them into database in batches
# Port: 8003
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///urls.db
# Production (PostgreSQL - Neon/Supabase):
# DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

# Database Connection Pooling (for PostgreSQL + PgBouncer)
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True
DB_ECHO_POOL=False

# =============================================================================
# ID Generator Configuration (Snowflake-based)
# =============================================================================
# Must match shorten service configuration
DATACENTER_ID=0
WORKER_ID=0
EPOCH_SEC=1704067200

# Bit Allocation (must match shorten service)
TIMESTAMP_BITS=31
DATACENTER_BITS=4
WORKER_BITS=2
SEQUENCE_BITS=10

# =============================================================================
# Application Configuration
# =============================================================================
# Not used by batch processor
BASE_DOMAIN=localhost:8003
BASE_URL_SCHEME=http

# =============================================================================
# Server Configuration
# =============================================================================
# Batch processor runs on port 8003
HOST=0.0.0.0
PORT=8003
RELOAD=True

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=DEBUG

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_ENABLED=True
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=3600

# =============================================================================
# Redis Configuration (Upstash Redis)
# =============================================================================
# Development: Leave empty to use in-memory LRU cache
# Production: Use Upstash Redis URL
REDIS_URL=
REDIS_ENABLED=False

# Redis Connection Pooling
REDIS_POOL_MAX_CONNECTIONS=50

# Redis Timeout Configuration (separate for cache vs queue)
REDIS_CACHE_SOCKET_TIMEOUT=1        # Cache operations (fail fast)
REDIS_CACHE_CONNECT_TIMEOUT=1        # Cache connection
REDIS_QUEUE_SOCKET_TIMEOUT=3         # Queue operations (more important)
REDIS_QUEUE_CONNECT_TIMEOUT=2        # Queue connection

# =============================================================================
# Queue Configuration (REQUIRED for batch processor)
# =============================================================================
QUEUE_ENABLED=False
BATCH_SIZE=100
BATCH_INTERVAL_SECONDS=10           # URL batch processing interval
CLICK_BATCH_INTERVAL_SECONDS=30     # Click analytics batch processing interval
ENABLE_BACKGROUND_SCHEDULER=True    # Set True for local dev to run background processing

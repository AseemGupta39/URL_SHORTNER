# Click Processor Service Environment Variables
# Copy this file to .env and update values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/url_shortener
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO_POOL=false

# Server Configuration
HOST=0.0.0.0
PORT=8004
RELOAD=true

# Logging
LOG_LEVEL=DEBUG

# Redis Configuration (REQUIRED)
REDIS_URL=redis://localhost:6379
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_QUEUE_SOCKET_TIMEOUT=3
REDIS_QUEUE_CONNECT_TIMEOUT=2

# Queue Configuration
BATCH_SIZE=100
CLICK_BATCH_INTERVAL_SECONDS=5
ENABLE_BACKGROUND_SCHEDULER=true

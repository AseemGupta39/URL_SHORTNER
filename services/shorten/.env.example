# =============================================================================
# Shorten Service Environment Variables
# This service creates short URLs with unique IDs
# Port: 8001
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///urls.db
# Production (PostgreSQL - Neon/Supabase):
# DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

# Database Connection Pooling (for PostgreSQL + PgBouncer)
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True
DB_ECHO_POOL=False

# =============================================================================
# ID Generator Configuration (Snowflake-based)
# =============================================================================
# MUST be unique per instance
DATACENTER_ID=0
WORKER_ID=0
EPOCH_SEC=1704067200

# Bit Allocation (47 bits total for 8-character codes)
# Current configuration: 31+4+2+10 = 47 bits
TIMESTAMP_BITS=31    # ~50 years time range
DATACENTER_BITS=4    # 16 datacenters (0-15)
WORKER_BITS=2        # 4 workers per DC (0-3)
SEQUENCE_BITS=10     # 1024 IDs/second per worker

# =============================================================================
# Application Configuration
# =============================================================================
# BASE_DOMAIN should point to where users will access short URLs (redirect service or load balancer)
BASE_DOMAIN=localhost:8002
BASE_URL_SCHEME=http

# =============================================================================
# Server Configuration
# =============================================================================
# Shorten service runs on port 8001
HOST=0.0.0.0
PORT=8001
RELOAD=True

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=DEBUG

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_ENABLED=True
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=3600

# =============================================================================
# Redis Configuration (Upstash Redis)
# =============================================================================
# Development: Leave empty to use in-memory LRU cache
# Production: Use Upstash Redis URL
REDIS_URL=
REDIS_ENABLED=False

# Redis Connection Pooling
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# Queue Configuration (Async Batch Processing)
# =============================================================================
QUEUE_ENABLED=False
BATCH_SIZE=100
BATCH_INTERVAL_SECONDS=10
ENABLE_BACKGROUND_SCHEDULER=False  # Not needed for shorten service
